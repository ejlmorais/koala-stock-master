# Neon Postgres connection string (same provider as koala-bar)
DATABASE_URL=

# Shared secret koala-bar uses to call this API.
# Send it as "Authorization: Bearer <key>" or "x-api-key: <key>".
STOCK_API_KEY=

# Set automatically by Vercel when you add a cron secret; used to authorize
# the daily GET /api/sales/sync invocation from Vercel Cron.
CRON_SECRET=

# Comma-separated list of browser origins allowed to call this API (CORS),
# e.g. https://koala-bar.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Weekdays the business is closed, 0=Sunday … 6=Saturday (default: 1 = Monday).
# The daily sync and analytics skip these days.
# CLOSED_WEEKDAYS=1

# Zonesoft ZSBMS backoffice credentials (the ones used on zsbmsv2.zonesoft.org)
ZONESOFT_NIF=
ZONESOFT_USERNAME=
ZONESOFT_PASSWORD=

# Optional overrides — defaults match the production ZSBMS environment
# ZONESOFT_AUTH_URL=https://auth.zonesoft.org
# ZONESOFT_APP_URL=https://client.zonesoft.org
# Extra fields merged into the report Data payload (JSON object), e.g. {"f_lojas":[1,2]}
# ZONESOFT_REPORT_DATA=
